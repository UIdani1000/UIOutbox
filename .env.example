# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MULTI-PROVIDER AI ROUTER:
# 1. Google Gemini (Priority 1)
# GEMINI_API_KEY is configured via AI Studio secrets

# 2. Groq API Key & Model (Priority 2 / High-Speed Inference)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# 3. OpenAI API Key & Model (Priority 3 / Deep Personalization)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 4. Anthropic Claude API Key & Model (Priority 4 / Creative Director Synthesis)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# 5. OpenRouter API Key & Model (Priority 5 / Free & Multi-Model Emergency Gateway)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# OPTIONAL MODEL OVERRIDES:
GEMINI_MODEL=""

# BATCH CONCURRENCY CONTROL:
AI_MAX_CONCURRENCY="3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Connect your Supabase project (URL & Anon Key for client, Service Role for server if applicable).
# When not set, UIOutbox seamlessly uses the local persistence engine.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# GOOGLE OAUTH & GMAIL API (BUILD 05 & REAL PRODUCTION DELIVERY):
# Configure in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Set Authorized redirect URI to: <YOUR_APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GMAIL_DELIVERY_MODE="production"
GOOGLE_ACCESS_TOKEN=""
GOOGLE_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL="big.nssien@gmail.com"



